export SE_OBJECT_STORE_TYPE=s3
# Use SE_S3_ prefix to configure the specific opendal service
export SE_S3_BUCKET=af-ops
export SE_S3_ENDPOINT=http://127.0.0.1:8333
# Or use the standard environment variables
export AWS_ACCESS_KEY_ID="seaweedfs-root-user"
export AWS_SECRET_ACCESS_KEY="seaweedfs-root-password"
export AWS_DEFAULT_REGION="local"
export AWS_ALLOW_HTTP=true

# Secret store defaults to file-backed storage in the configured object store.
export SE_SECRET_STORE_TYPE=file
# To use Azure Key Vault instead, authenticate with `az login` and set:
# export SE_SECRET_STORE_TYPE=azure-key-vault
# export SE_AZURE_KEY_VAULT_URL="https://<vault-name>.vault.azure.net/"
# If AZURE_FEDERATED_TOKEN_FILE is set, workload identity is used instead of CLI login.
# It also requires AZURE_TENANT_ID and AZURE_CLIENT_ID.
